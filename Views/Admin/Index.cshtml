@{
    ViewData["Title"] = "Administration";
}

<div class="py-4">
    <a class="btn btn-link text-decoration-none px-0 mb-3" asp-controller="Home" asp-action="Index">&larr; Home</a>
    <h1 class="h4 fw-semibold text-center mb-4">Administration</h1>

    <h2 class="h6 text-uppercase text-muted mb-3">Accounts</h2>
    <div class="row g-4 mb-5">
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">
            <a class="card border-0 shadow-sm h-100 text-decoration-none text-reset home-tile"
               asp-controller="Admin" asp-action="Accounts">
                <div class="card-body p-5 d-flex flex-column align-items-center text-center">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mb-4"
                         style="width: 5rem; height: 5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4" />
                        </svg>
                    </div>
                    <h3 class="h5 fw-semibold mb-2">System Accounts</h3>
                    <p class="text-muted small mb-0">View all accounts registered in the system.</p>
                </div>
            </a>
        </div>
    </div>

    <h2 class="h6 text-uppercase text-muted mb-3">Monitoring</h2>
    <div class="row g-4">
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">
            <a class="card border-0 shadow-sm h-100 text-decoration-none text-reset home-tile"
               asp-controller="Admin" asp-action="Metrics">
                <div class="card-body p-5 d-flex flex-column align-items-center text-center">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mb-4"
                         style="width: 5rem; height: 5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M4 11H2v3h2zm5-4H7v7h2zm5-5v12h-2V2zm-2-1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1zM6 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1zm-5 4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1z" />
                        </svg>
                    </div>
                    <h3 class="h5 fw-semibold mb-2">Company Metrics</h3>
                    <p class="text-muted small mb-0">Monitor key company indicators.</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">
            <a class="card border-0 shadow-sm h-100 text-decoration-none text-reset home-tile"
               asp-controller="Admin" asp-action="ActivityLogs">
                <div class="card-body p-5 d-flex flex-column align-items-center text-center">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mb-4"
                         style="width: 5rem; height: 5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M5 10.5a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m0-2a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5" />
                            <path d="M3 0h10a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-1h1v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v1H1V2a2 2 0 0 1 2-2" />
                            <path d="M1 5v-.5a.5.5 0 0 1 1 0V5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0V8h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1zm0 3v-.5a.5.5 0 0 1 1 0v.5h.5a.5.5 0 0 1 0 1h-2a.5.5 0 0 1 0-1z" />
                        </svg>
                    </div>
                    <h3 class="h5 fw-semibold mb-2">Activity Logs</h3>
                    <p class="text-muted small mb-0">Monitor user activity in the system.</p>
                </div>
            </a>
        </div>
    </div>
</div>
