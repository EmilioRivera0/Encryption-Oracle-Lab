<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="h6 text-uppercase text-muted fw-semibold mb-0 section-label">Staff Insights</h2>
    <span class="badge rounded-pill text-bg-light border live-badge"><span class="live-dot"></span>Updated today</span>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-4">
        <div class="card border-0 shadow-sm insight-card h-100">
            <div class="card-body">
                <div class="text-muted small">Sales this month</div>
                <div class="h4 fw-semibold mb-0">$48.2K</div>
                <span class="small text-success">&#9650; 12.4%</span>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card border-0 shadow-sm insight-card h-100">
            <div class="card-body">
                <div class="text-muted small">Budget used</div>
                <div class="h4 fw-semibold mb-0">68%</div>
                <span class="small text-muted">of $335K allocated</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm insight-card h-100">
            <div class="card-body">
                <div class="text-muted small">New accounts</div>
                <div class="h4 fw-semibold mb-0">126</div>
                <span class="small text-success">&#9650; 4.1%</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-7">
        <div class="card border-0 shadow-sm insight-card h-100">
            <div class="card-body">
                <div class="fw-semibold mb-3">Weekly sales</div>
                <div class="chart-box"><canvas id="staffSalesChart"></canvas></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-5">
        <div class="card border-0 shadow-sm insight-card h-100">
            <div class="card-body">
                <div class="fw-semibold mb-3">Budget by department</div>
                <div class="chart-box"><canvas id="staffBudgetChart"></canvas></div>
            </div>
        </div>
    </div>
</div>
