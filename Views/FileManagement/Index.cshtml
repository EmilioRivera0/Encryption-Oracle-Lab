@{
    ViewData["Title"] = "File Management";
}

<div class="text-center py-5">
    <h1 class="display-6 fw-semibold">File Management</h1>

    <div class="row justify-content-center g-4 mt-4">
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">
            <a class="card border-0 shadow-sm h-100 text-decoration-none text-reset home-tile"
               asp-controller="FileManagement" asp-action="Upload">
                <div class="card-body p-5 d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mb-4"
                         style="width: 5rem; height: 5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5" />
                            <path d="M7.646 1.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1-.708.708L8.5 2.707V11.5a.5.5 0 0 1-1 0V2.707L5.354 4.854a.5.5 0 1 1-.708-.708z" />
                        </svg>
                    </div>
                    <h2 class="h5 fw-semibold mb-2">Upload File</h2>
                    <p class="text-muted small mb-0">Upload a new file.</p>
                </div>
            </a>
        </div>
        <div class="col-12 col-sm-8 col-md-5 col-lg-4">
            <a class="card border-0 shadow-sm h-100 text-decoration-none text-reset home-tile"
               asp-controller="FileManagement" asp-action="Download">
                <div class="card-body p-5 d-flex flex-column align-items-center">
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mb-4"
                         style="width: 5rem; height: 5rem;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5" />
                            <path d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z" />
                        </svg>
                    </div>
                    <h2 class="h5 fw-semibold mb-2">Download Files</h2>
                    <p class="text-muted small mb-0">Download your files.</p>
                </div>
            </a>
        </div>
    </div>
</div>
